# Replace these examples with the canonical origins for the deployment.
# A reverse proxy can route sca.fcu.gov to Astro and login.fcu.gov/dex to Dex.
ASTRO_PUBLIC_ORIGIN=https://sca.fcu.gov
DEX_ISSUER=https://login.fcu.gov/dex
DEX_INTERNAL_ISSUER=https://login.fcu.gov/dex

# This may be an internal DNS name, routed address, or reverse-proxy endpoint.
STONEHENGE_API_BASE_URL=http://stonehenge-api.internal:8092/api/v1
STONEHENGE_ASTRO_API_KEY=replace-with-generated-astro-key

ASTRO_OIDC_CLIENT_SECRET=replace-with-random-client-secret
ASTRO_SESSION_SECRET=replace-with-at-least-32-random-bytes
ASTRO_REVIEW_DB_PATH=/data/astro-review.sqlite
ASTRO_REVIEW_MAX_ATTEMPTS=3
ASTRO_REVIEWER_WORKER_ID=astro-reviewer-1
ASTRO_REVIEWER_LEASE_MS=15000
ASTRO_REVIEWER_NAVIGATION_TIMEOUT_MS=10000
ASTRO_REVIEWER_TOTAL_TIMEOUT_MS=20000
ASTRO_REVIEWER_WINDOW_MS=2000
ASTRO_REVIEWER_HEALTH_URL=http://127.0.0.1:3001/health
