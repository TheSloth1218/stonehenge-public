{
  "name": "stonehenge-control-authority",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "NODE_ENV=test vitest run tests/unit && tsx --test tests/unit/*.node.test.ts",
    "training:test": "npm run test:unit && npm run training:test:xss && npm run training:test:reviewer",
    "training:test:xss": "playwright test tests/e2e/target-xss.spec.ts --project=training-vulnerable",
    "training:test:reviewer": "tsx tools/training/run-astro-reviewer-demo.ts",
    "training:test:recovery": "bash tools/training/run-reviewer-recovery.sh",
    "training:report": "tsx tools/training/generate-report.ts",
    "reviewer": "tsx reviewer/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "next": "^15.5.25",
    "playwright": "1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
