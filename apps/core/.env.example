# Caddy is the public TLS edge. DNS is managed outside this repository and must
# resolve these names to the deployed host. Direct app/API ports remain on
# loopback for diagnostics and cannot bypass Caddy from another host.
STONEHENGE_EDGE_HOST_IP=0.0.0.0
ENGINEERING_HOSTNAME=engineering.fcu.gov
STONEHENGE_API_HOSTNAME=api.fcu.gov
STONEHENGE_ACME_CA_DIRECTORY=https://ca.fcu.gov:8443/acme/acme/directory

ENGINEERING_APP_HOST_IP=127.0.0.1
ENGINEERING_APP_PORT=8088
STONEHENGE_API_HOST_IP=127.0.0.1
STONEHENGE_API_PORT=8092
STONEHENGE_API_SWAGGER_ENABLED=false

# Engineering App authentication. Keep Dev until the Dex client and secret are
# configured, then serve the app through https://engineering.fcu.gov.
STONEHENGE_AUTH_MODE=Dev
STONEHENGE_OIDC_AUTHORITY=https://login.fcu.gov/dex
STONEHENGE_OIDC_CLIENT_ID=stonehenge-engineering
STONEHENGE_OIDC_CLIENT_SECRET=
STONEHENGE_OIDC_CALLBACK_PATH=/signin-oidc
STONEHENGE_OIDC_SIGNED_OUT_CALLBACK_PATH=/signout-callback-oidc
STONEHENGE_OIDC_REQUIRE_HTTPS_METADATA=true
STONEHENGE_SHOW_DEV_AUTH=true
STONEHENGE_TRUSTED_PROXY_IP=172.28.0.5
STONEHENGE_TRUSTED_PROXY_NETWORK=

# Dex should emit dedicated application groups. Engineering membership is
# evaluated before admin membership, so an administrator outside Engineering
# remains dashboard-only.
STONEHENGE_ENGINEERING_CLAIM_TYPE=groups
STONEHENGE_ENGINEERING_CLAIM_VALUE=SCA-Engineering-Users
STONEHENGE_ENGINEERING_ADMIN_CLAIM_VALUE=SCA-Engineering-Admins
STONEHENGE_ADMIN_CLAIM_TYPE=groups
STONEHENGE_ADMIN_CLAIM_VALUE=SCA-Engineering-Admins

# Middleware, FUXA, target feed, OpenPLC management, PostgreSQL, and Modbus
# remain internal or loopback-only by default. Do not expose them just because
# the host management subnet changes.
MIDDLEWARE_HOST_IP=127.0.0.1
FUXA_HOST_IP=127.0.0.1
TARGET_FEED_HOST_IP=127.0.0.1
