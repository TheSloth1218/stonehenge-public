{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "Stonehenge": {
    "MiddlewareBaseUrl": "http://middleware:8080",
    "UseLiveMiddlewareAstroData": true,
    "AllowSeededAstroFallback": false
  },
  "Operational": {
    "MaintenanceShotThreshold": 200
  },
  "TrainingVulnerabilities": {
    "Enabled": false,
    "EnableVendorFieldExpansionLeak": true,
    "EnableVendorGunStatusDiagnosticLeak": true,
    "EnableAstroFieldExpansionLeak": true,
    "EnableCompletionReplay": true,
    "EnableCrossClientScopeConfusion": false,
    "EnableVerboseScopeErrors": true
  },
  "VendorApi": {
    "UseSeededData": true
  },
  "ApiKeyAuth": {
    "Pepper": "development-only-change-me",
    "AllowLegacyDevKeys": true,
    "Keys": []
  }
}
