{
  "TrainingVulnerabilities": {
    "Enabled": false,
    "SessionLifetimeMinutes": 15,
    "PanelTokenLifetimeSeconds": 90
  },
  "Operational": {
    "MaintenanceShotThreshold": 200
  },
  "Authentication": {
    "Mode": "Dev",
    "DataProtectionKeysPath": "/data/data-protection-keys",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "RequireHttpsMetadata": true,
      "Scopes": ["openid", "profile", "email", "groups"],
      "AllowedGroups": [
        "STONEHENGE_EMPLOYEES",
        "STONEHENGE_ENGINEERING_USERS",
        "STONEHENGE_ENGINEERING_ADMINS"
      ],
      "EngineeringBoundary": {
        "ClaimTypes": ["groups"],
        "Values": ["STONEHENGE_ENGINEERING_USERS", "STONEHENGE_ENGINEERING_ADMINS", "SCA-Engineering-Users", "SCA-Engineering-Admins"],
        "ValueFragments": []
      },
      "AdminBoundary": {
        "ClaimTypes": ["groups"],
        "Values": ["STONEHENGE_ENGINEERING_ADMINS", "SCA-Engineering-Admins"],
        "ValueFragments": []
      }
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "Fuxa": {
    "Enabled": false,
    "BaseUrl": "",
    "EmbedPathTemplate": "/stonehenge/embed/{fuxaViewId}",
    "FrameTitlePrefix": "Stonehenge FUXA",
    "DefaultPanelHeight": 720,
    "AllowDirectExternalFuxaLinks": false
  },
  "StonehengeApi": {
    "Enabled": true,
    "BaseUrl": "http://stonehenge-api:8080/api/v1",
    "ApiKey": "engineering-dev-key"
  }
}
