POSTGRES_DB=stonehenge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=stonehenge_writer
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_WRITE_QUEUE_SIZE=1000
POSTGRES_RETRY_INTERVAL_SECONDS=5
HISTORY_ADAPTER=postgres
STONEHENGE_CONFIG=/app/configs/config.linux.example.json
COMPOSE_PROJECT_NAME=stonehenge-middleware

MIDDLEWARE_HOST_IP=127.0.0.1
MIDDLEWARE_PORT=8080
FUXA_HOST_IP=127.0.0.1
FUXA_PORT=1881

OPENPLC_IMAGE=ghcr.io/autonomy-logic/openplc-runtime:latest
OPENPLC_CONTROL_HOST_IP=127.0.0.1
OPENPLC_WEB_PORT=8443
OPENPLC_DISCOVERY_PORT=33333
OPENPLC_SAFETY_HOST_IP=127.0.0.1
OPENPLC_SAFETY_WEB_PORT=8450
OPENPLC_SAFETY_DISCOVERY_PORT=33340
OPENPLC_GUN2_HOST_IP=127.0.0.1
OPENPLC_GUN2_WEB_PORT=8444
OPENPLC_GUN2_DISCOVERY_PORT=33334
OPENPLC_GUN3_HOST_IP=127.0.0.1
OPENPLC_GUN3_WEB_PORT=8445
OPENPLC_GUN3_DISCOVERY_PORT=33335
OPENPLC_GUN4_HOST_IP=127.0.0.1
OPENPLC_GUN4_WEB_PORT=8446
OPENPLC_GUN4_DISCOVERY_PORT=33336
OPENPLC_GUN5_HOST_IP=127.0.0.1
OPENPLC_GUN5_WEB_PORT=8447
OPENPLC_GUN5_DISCOVERY_PORT=33337
OPENPLC_GUN6_HOST_IP=127.0.0.1
OPENPLC_GUN6_WEB_PORT=8448
OPENPLC_GUN6_DISCOVERY_PORT=33338
OPENPLC_GUN7_HOST_IP=127.0.0.1
OPENPLC_GUN7_WEB_PORT=8449
OPENPLC_GUN7_DISCOVERY_PORT=33339
OPENPLC_GUN8_HOST_IP=127.0.0.1
OPENPLC_GUN8_WEB_PORT=8451
OPENPLC_GUN8_DISCOVERY_PORT=33341

PLC_HOST=openplc-control-gun1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_COMMAND_ACK_TIMEOUT_SECONDS=5
PLC_POLL_INTERVAL_MS=100
PLC_LIFECYCLE_POLL_INTERVAL_MS=200
PLC_LIFECYCLE_COMPLETION_TIMEOUT_SECONDS=30
PLC_LIFECYCLE_MAX_CONSECUTIVE_READ_ERRORS=5
PLC_AUTO_READINESS_POLL_INTERVAL_MS=500
PLC_AUTO_SAFETY_FIRE_PERMISSIVE=false
PLC_AUTO_TELEMETRY_MODBUS_ENABLED=true
PLC_AUTO_TELEMETRY_MODBUS_ADDR=0.0.0.0:1502
PLC_AUTO_TELEMETRY_UNIT_ID=1
PLC_AUTO_TELEMETRY_POLL_INTERVAL=500ms
PLC_AUTO_TELEMETRY_STALE_AFTER=3s
PLC_FAULT_RESET_TIMEOUT=30s
PLC_STARTUP_MODE=manual
PLC_STARTUP_MODE_RETRY_TIMEOUT=5m
# Optional multi-gun override. Leave unset to use configs/config.linux.example.json,
# which configures Guns 1-8 for dispatcher execution.
# GUNS_CONFIG_JSON=[{"id":1,"name":"Gun 1","safety_gun_id":1,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun1","port":502,"unit_id":1}},{"id":2,"name":"Gun 2","safety_gun_id":2,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun2","port":502,"unit_id":1}},{"id":3,"name":"Gun 3","safety_gun_id":3,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun3","port":502,"unit_id":1}},{"id":4,"name":"Gun 4","safety_gun_id":4,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun4","port":502,"unit_id":1}},{"id":5,"name":"Gun 5","safety_gun_id":5,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun5","port":502,"unit_id":1}},{"id":6,"name":"Gun 6","safety_gun_id":6,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun6","port":502,"unit_id":1}},{"id":7,"name":"Gun 7","safety_gun_id":7,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun7","port":502,"unit_id":1}},{"id":8,"name":"Gun 8","safety_gun_id":8,"auto_enabled":true,"dispatcher_eligible":true,"auto_executor_enabled":true,"plc":{"host":"openplc-control-gun8","port":502,"unit_id":1}}]

TARGET_FEED_ENABLED=true
TARGET_FEED_MAX_PENDING=25
TARGET_FEED_TARGET_TTL=2m
TARGET_FEED_HEALTHY_WINDOW=30s
TARGET_FEED_DISPATCH_POLL_INTERVAL_MS=500

DISPATCHER_ENABLED=true
DISPATCHER_MODE=active
DISPATCHER_POLL_INTERVAL_MS=500
DISPATCHER_ASSIGNMENT_LEASE_DURATION=90s
DISPATCHER_LEASE_RENEWAL_INTERVAL=30s
DISPATCHER_RECONCILIATION_INTERVAL=5s
DISPATCHER_SHADOW_DECISION_RETENTION=10m
DISPATCHER_ELEVATION_WEIGHT=1

STONEHENGE_CONTROL_TOKEN=
STONEHENGE_INGEST_TOKEN=
STONEHENGE_FUXA_PROXY_TOKEN=
STONEHENGE_TEST_CONTROLS=false
STONEHENGE_TEST_TOKEN=
STONEHENGE_MAINTENANCE_CONTROLS=false
STONEHENGE_MAINTENANCE_TOKEN=
STONEHENGE_MAINTENANCE_SCRIPT=/host/tools/maintenance/stonehenge-maintenance
STONEHENGE_MAINTENANCE_TIMEOUT=20m
STONEHENGE_HOST_REPO=/opt/stonehenge-middleware
STONEHENGE_MAINTENANCE_RUNNER_IMAGE=stonehenge-middleware-middleware

SAFETY_PLC_ENABLED=true
SAFETY_PLC_ENFORCEMENT=true
SAFETY_PLC_HOST=openplc-safety
SAFETY_PLC_PORT=502
SAFETY_PLC_UNIT_ID=1
SAFETY_PLC_POLL_INTERVAL=250ms
SAFETY_PLC_STALE_AFTER=2s
SAFETY_PLC_STATUS_REGISTER_TYPE=input
SAFETY_PLC_MW_REGISTER_BASE=80
SAFETY_PLC_RESET_PULSE_DURATION=750ms
