# Browser-visible example origins. Replace them with the deployment's canonical
# DNS names; the applications do not derive these values from request headers.
DEX_ISSUER=https://login.fcu.gov/dex
LOGIN_PORTAL_PUBLIC_ORIGIN=https://login.fcu.gov
ASTRO_PUBLIC_ORIGIN=https://sca.fcu.gov
VENDOR_PUBLIC_ORIGIN=https://vendor.fcu.gov
ENGINEERING_PUBLIC_ORIGIN=https://engineering.fcu.gov

# Use a unique client secret for every registered application.
LOGIN_PORTAL_OIDC_CLIENT_SECRET=replace-with-random-client-secret
ASTRO_OIDC_CLIENT_SECRET=replace-with-random-client-secret
VENDOR_OIDC_CLIENT_SECRET=replace-with-random-client-secret
ENGINEERING_OIDC_CLIENT_SECRET=replace-with-random-client-secret
LOGIN_PORTAL_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Keep config.local.yaml only for isolated development. Select the LDAPS
# connector after creating a read-only directory bind account.
DEX_CONFIG_FILE=config.ldap.yaml
DEX_LDAP_HOST=fcu-dc.fcu.gov
DEX_LDAP_BIND_DN=svc_dex@fcu.gov
DEX_LDAP_BIND_PASSWORD=replace-me
DEX_LDAP_USER_BASE_DN=DC=fcu,DC=gov
DEX_LDAP_GROUP_BASE_DN=DC=fcu,DC=gov

# Smallstep ACME directory used when TLS termination is deployed.
FCU_ACME_DIRECTORY=https://ca.fcu.gov:8443/acme/acme/directory

# Preferred for reusable browser SSO when AD FS or another AD-backed OIDC
# provider is available.
DEX_UPSTREAM_OIDC_ISSUER=https://adfs.fcu.example/adfs
DEX_UPSTREAM_OIDC_CLIENT_ID=stonehenge-dex
DEX_UPSTREAM_OIDC_CLIENT_SECRET=replace-me
