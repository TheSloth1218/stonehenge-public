# Install as /etc/stonehenge-vendor/stonehenge-vendor.env with mode 0600.
# Hostnames are deployment inputs. The values below are FCU examples.
SPRING_PROFILES_ACTIVE=training
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8089

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stonehenge_vendor
SPRING_DATASOURCE_USERNAME=stonehenge_vendor
SPRING_DATASOURCE_PASSWORD=replace-me

OIDC_ISSUER=https://login.fcu.gov/dex
OIDC_CLIENT_ID=stonehenge-vendor
OIDC_CLIENT_SECRET=replace-with-unique-vendor-client-secret
OIDC_SCOPES=openid,profile,email,groups
APP_PUBLIC_ORIGIN=https://vendor.fcu.gov
AUTH_SESSION_SECRET=replace-with-independent-random-value-of-at-least-32-characters
SCA_EMPLOYEE_GROUP=SCA-Employees
SCA_ADMIN_GROUP=SCA-Admins

SESSION_COOKIE_SECURE=true
# Use framework only when a trusted reverse proxy sanitizes Forwarded and X-Forwarded-*.
SERVER_FORWARD_HEADERS_STRATEGY=framework

STONEHENGE_API_BASE_URL=https://api.fcu.gov/api/v1
STONEHENGE_VENDOR_API_KEY=replace-me
